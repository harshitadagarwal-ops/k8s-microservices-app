{
  "_comment": "Permissions to add for IAM user Harshita-Agarwal-Avyka (account 105673693246) so the kube-pilot EKS stack and app image push work with no workarounds. Covers ECR (create repo + push, any name), KMS (EKS secret encryption), and CloudWatch Logs (EKS control-plane logging). IAM delete/detach is intentionally EXCLUDED to avoid accidental deletion. Attach to the Internal-Hackathon group's IAM-Limited-Access policy (or as a new managed policy). eks:*, ec2:*, vpc, s3, dynamodb, and iam create/tag are already granted.",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrAuthAccountWide",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "EcrCreateAndPush",
      "Effect": "Allow",
      "Action": [
        "ecr:CreateRepository",
        "ecr:DescribeRepositories",
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": "*"
    },
    {
      "Sid": "KmsForEksSecretEncryption",
      "Effect": "Allow",
      "Action": [
        "kms:CreateKey",
        "kms:CreateAlias",
        "kms:DeleteAlias",
        "kms:TagResource",
        "kms:UntagResource",
        "kms:ScheduleKeyDeletion",
        "kms:DescribeKey",
        "kms:ListAliases",
        "kms:PutKeyPolicy",
        "kms:GetKeyPolicy",
        "kms:GetKeyRotationStatus",
        "kms:EnableKeyRotation"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudWatchLogsForEksControlPlane",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DescribeLogGroups",
        "logs:ListTagsForResource",
        "logs:TagResource",
        "logs:UntagResource"
      ],
      "Resource": "*"
    }
  ]
}
