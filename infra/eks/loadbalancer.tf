# AWS Load Balancer Controller.
# Watches Kubernetes Ingress / Service(type=LoadBalancer) objects and
# provisions real AWS ALBs / NLBs. Required so the app's ingress-nginx
# (or any Ingress) gets a public load balancer on EKS.
#
# Toggle with var.enable_lb_controller (set in terraform.tfvars).

# IRSA role the controller assumes to call the ELB / EC2 APIs.
module "lb_controller_irsa" {
  count = var.enable_lb_controller ? 1 : 0

  source  = "terraform-aws-modules/iam/aws//modules/iam-role-for-service-accounts-eks"
  version = "~> 5.44"

  role_name                              = "${var.cluster_name}-lb-controller"
  attach_load_balancer_controller_policy = true

  oidc_providers = {
    main = {
      provider_arn               = module.eks.oidc_provider_arn
      namespace_service_accounts = ["kube-system:aws-load-balancer-controller"]
    }
  }

  tags = var.tags
}

# The controller itself, installed via its official Helm chart.
resource "helm_release" "lb_controller" {
  count = var.enable_lb_controller ? 1 : 0

  name       = "aws-load-balancer-controller"
  repository = "https://aws.github.io/eks-charts"
  chart      = "aws-load-balancer-controller"
  version    = var.lb_controller_chart_version
  namespace  = "kube-system"

  set {
    name  = "clusterName"
    value = module.eks.cluster_name
  }

  set {
    name  = "serviceAccount.create"
    value = "true"
  }

  set {
    name  = "serviceAccount.name"
    value = "aws-load-balancer-controller"
  }

  set {
    name  = "serviceAccount.annotations.eks\\.amazonaws\\.com/role-arn"
    value = module.lb_controller_irsa[0].iam_role_arn
  }

  set {
    name  = "region"
    value = var.region
  }

  set {
    name  = "vpcId"
    value = module.vpc.vpc_id
  }

  depends_on = [module.eks]
}
